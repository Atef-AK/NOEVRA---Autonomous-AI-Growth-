# GrowthOS Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to git

# ============================================================
# Application
# ============================================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://growthos:growthos_dev@localhost:5432/growthos_dev?schema=public

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# Authentication
# ============================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_64_CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ============================================================
# Encryption (for OAuth token storage)
# ============================================================
# Generate with: openssl rand -hex 32 (must be exactly 32 bytes hex = 64 chars)
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY_64_CHARS_TOTAL

# ============================================================
# Object Storage (S3-compatible)
# ============================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=growthos-dev
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# ============================================================
# AI Providers (add keys for providers you have access to)
# ============================================================
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_KEY
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_KEY
GOOGLE_AI_API_KEY=REPLACE_WITH_GOOGLE_AI_KEY

# Default AI provider to use
AI_DEFAULT_PROVIDER=google
AI_DEFAULT_MODEL=gemini-2.0-flash

# ============================================================
# Email (for verification emails, notifications)
# ============================================================
EMAIL_FROM=noreply@growthos.ai
# SMTP config (or use Resend/SendGrid API key)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# OR use Resend
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY

# ============================================================
# Observability
# ============================================================
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN_OR_LEAVE_EMPTY
LOG_LEVEL=debug

# ============================================================
# Billing (Stripe) — feature flagged until Phase 10
# ============================================================
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY

# ============================================================
# Feature Flags (set to 'true' to enable)
# ============================================================
FEATURE_BILLING=false
FEATURE_COMMUNITY_AGENT=false
FEATURE_PAID_ADS=false
FEATURE_AUTONOMOUS_MODE=false
FEATURE_VIDEO_GENERATION=false

# ============================================================
# Social Connectors (configure per connector, Phase 6+)
# ============================================================
TWITTER_CLIENT_ID=REPLACE
TWITTER_CLIENT_SECRET=REPLACE
LINKEDIN_CLIENT_ID=REPLACE
LINKEDIN_CLIENT_SECRET=REPLACE
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
